mutation {
  addConcept(input: [
    { name: "List" arguments: [{ ownerConcept: {name: "List"} positionAngle:180 name: "List.of" capacity: "infinite"}] wh:"150:60"},
    { name: "Someone else" arguments: [{ ownerConcept: {name: "Someone else"} positionAngle:180 name: "Someone else.than" capacity: "infinite"}] wh:"150:60"},
    {
      name: "Other people"
      arguments: [{ ownerConcept: {name: "Other people"} positionAngle:180 name: "Other people.than" capacity: "infinite"}]
      composition: {
        ownerConcept: {name: "Other people"}
        subConcepts: [
          {
            concept: {name: "List"}
            xy: "0:-200"
          }, {
            concept: {name: "Someone else"}
            xy: "0:200"}
        ]
        connections: [
          {
            ownerConceptComposition: {
              ownerConcept: {name: "Other people"}
            }
            fedSubConceptKey: "0:-200"
            fedSubConceptArgumentType: {
              name: "List.of"
            }
            argumentFeederType: OtherSubConcept
            argumentFeederKey: "0:200"
          }, {
            ownerConceptComposition: {
              ownerConcept: {name: "Other people"}
            }
            fedSubConceptKey: "0:200"
            fedSubConceptArgumentType: {
              name: "Someone else.than"
            }
            argumentFeederType: OwnerArgument
            argumentFeederKey: "Other people.than"
          }
        ]
      }
      wh:"150:60"
    },
    { name: "Someone" arguments: [] wh:"150:60" },
    { name: "Concept" arguments: [] wh:"150:60" },
    {
      name: "Convey"
      arguments: [
        {ownerConcept: {name: "Convey"} positionAngle:180 name: "Convey.from" capacity: "infinite"},
        {ownerConcept: {name: "Convey"} positionAngle:0 name: "Convey.what" capacity: "infinite"},
        {ownerConcept: {name: "Convey"} positionAngle:90 name: "Convey.to" capacity: "infinite"}
      ]
      wh:"150:60"
    },
    {
      name: "Communication"
      arguments: []
      composition: {
        ownerConcept: {name: "Communication"}
        subConcepts: [
          {concept: {name: "Convey"} xy:"0:0"},
          {concept: {name: "Someone"} xy:"-200:200"},
          {concept: {name: "Concept"} xy:"-200:-200"}, 
          {concept: {name: "Other people"} xy:"200:0"},
        ]
        connections: [
          {
            ownerConceptComposition: {ownerConcept: {name: "Communication"}}
            fedSubConceptKey: "0:0" 
            fedSubConceptArgumentType: {name: "Convey.from"}
            argumentFeederType: OtherSubConcept
            argumentFeederKey: "-200:200"
          },
          {
            ownerConceptComposition: {ownerConcept: {name: "Communication"}}
            fedSubConceptKey: "0:0"
            fedSubConceptArgumentType: {name: "Convey.what"}
            argumentFeederType: OtherSubConcept
            argumentFeederKey: "-200:-200"
          },
          {
            ownerConceptComposition: {ownerConcept: {name: "Communication"}}
            fedSubConceptKey: "0:0"
            fedSubConceptArgumentType: {name: "Convey.to"}
            argumentFeederType: OtherSubConcept
            argumentFeederKey: "200:0"
          },
          {
            ownerConceptComposition: {ownerConcept: {name: "Communication"}}
            fedSubConceptKey: "200:0"
            fedSubConceptArgumentType: {name: "Other people.than"}
            argumentFeederType: OtherSubConceptArgument
            argumentFeederKey: "0:0" 
            argumentFeederArgumentType: {name: "Convey.from"}
          },
        ]
      }
      wh:"150:60"
    }
  ]) {
    concept {
      name
      arguments {
        name
        capacity
        positionAngle
      }
      composition {
        subConcepts {concept{name} xy}
        connections {
          fedSubConceptKey
          fedSubConceptArgumentType {name ownerConcept{name}} 
          argumentFeederType argumentFeederKey argumentFeederArgumentType {name}
        }
      }
      wh
    }
  }
}
